<Window x:Class="LiteList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:local="clr-namespace:LiteList"
        Title="LiteList" Width="1280" Height="800" MinWidth="760" MinHeight="500"
        Background="{DynamicResource AppBg}" Foreground="{DynamicResource TextFg}"
        Closing="Window_Closing" Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="FlatToolBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="MiniFmtBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部主工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleLeft" Style="{StaticResource FlatToolBtn}" Content="☰ 目录"
                            ToolTip="显示/隐藏左侧大纲 (Ctrl+\)" Click="BtnToggleLeft_Click"/>
                    <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="4,0">
                        <TextBlock x:Name="TxtDbBadge" Text="notes.llist" FontSize="12" FontWeight="SemiBold"
                                   MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Border>
                    <Button Style="{StaticResource FlatToolBtn}" Content="新建库" Click="BtnNewDb_Click"/>
                    <Button Style="{StaticResource FlatToolBtn}" Content="打开库" Click="BtnOpenDb_Click"/>
                    <Button x:Name="BtnExportMenu" Style="{StaticResource FlatToolBtn}" Content="导出 MD ▾" Click="BtnExportMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="仅导出当前选中节点 (.md)" Click="MenuExportSingleNode_Click"/>
                                <MenuItem Header="导出当前节点及全部子级 (.md)" Click="MenuExportSubtree_Click"/>
                                <Separator/>
                                <MenuItem Header="导出全部笔记库 (.md)" Click="MenuExportAll_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource FlatToolBtn}" Content="保存 (Ctrl+S)" Click="BtnSave_Click"/>
                    <Button Style="{StaticResource FlatToolBtn}" Content="设置" Click="BtnSettings_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSaveStatus" Text="已保存" FontSize="12" Margin="6,0,10,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedFg}"/>
                    <Button Style="{StaticResource FlatToolBtn}" Content="A-" ToolTip="减小正文字号" Click="BtnFontMinus_Click"/>
                    <Button Style="{StaticResource FlatToolBtn}" Content="A+" ToolTip="增大正文字号" Click="BtnFontPlus_Click"/>
                    <Button Style="{StaticResource FlatToolBtn}" Content="🔍 全局搜索 (Ctrl+K)" Width="165"
                            Click="BtnOpenGlobalSearch_Click"/>
                    <Button x:Name="BtnToggleRight" Style="{StaticResource FlatToolBtn}" Content="正文大纲 ☰"
                            ToolTip="显示/隐藏右侧正文大纲 (Ctrl+/)" Click="BtnToggleRight_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ListPro 风格：常驻非模态全局搜索面板（独立占行，跳转不关闭，不遮挡编辑区） -->
        <Border x:Name="GlobalSearchPanel" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="0,0,0,2" Padding="10,7">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGlobalSearchCount" Text="请输入关键词" FontSize="12"
                                   Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center" Margin="8,0"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="↑ 上一个 (Shift+F3)" Click="BtnGlobalPrev_Click"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="↓ 下一个 (F3)" Click="BtnGlobalNext_Click"/>
                        <ToggleButton x:Name="BtnToggleHitList" Content="命中列表 ▾" Padding="8,4" Margin="2,0" FontSize="12"
                                      Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextFg}"
                                      BorderBrush="{DynamicResource BorderBrush}" IsChecked="True"
                                      Checked="BtnToggleHitList_Changed" Unchecked="BtnToggleHitList_Changed"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="× 关闭 (Esc)" Click="BtnCloseGlobalSearch_Click"/>
                    </StackPanel>
                    <DockPanel>
                        <TextBlock Text="全局查找：" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatToolBtn}" Content="定位第 1 处" Click="BtnGlobalRun_Click"/>
                        <TextBox x:Name="TxtGlobalSearch" Padding="6,4" FontSize="13"
                                 Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextFg}"
                                 BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource CaretBrush}"
                                 PreviewKeyDown="TxtGlobalSearch_PreviewKeyDown"/>
                    </DockPanel>
                </DockPanel>

                <ListBox x:Name="LstGlobalHits" MaxHeight="165" Margin="0,6,0,0"
                         Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="LstGlobalHits_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,2">
                                <TextBlock Text="{Binding NodeTitle}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource TextFg}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Breadcrumb}" FontSize="11.5"
                                           Foreground="{DynamicResource MutedFg}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Snippet}" FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 主体三栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeftTree" Width="260" MinWidth="0"/>
                <ColumnDefinition x:Name="ColLeftSplit" Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ColRightSplit" Width="0"/>
                <ColumnDefinition x:Name="ColRightToc" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧全局大纲树 -->
            <Border x:Name="LeftSidebar" Grid.Column="0" Background="{DynamicResource SidebarBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="全局大纲" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MiniFmtBtn}" Content="⊞" ToolTip="全部展开" Click="BtnExpandAllTree_Click"/>
                                <Button Style="{StaticResource MiniFmtBtn}" Content="⊟" ToolTip="全部折叠" Click="BtnCollapseAllTree_Click"/>
                                <Button Style="{StaticResource MiniFmtBtn}" Content="+" FontWeight="Bold" ToolTip="新建根节点" Click="BtnAddRoot_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TreeView x:Name="OutlineTree" Background="Transparent" BorderThickness="0" Padding="4" AllowDrop="True"
                              SelectedItemChanged="OutlineTree_SelectedItemChanged"
                              PreviewKeyDown="OutlineTree_PreviewKeyDown"
                              PreviewMouseLeftButtonDown="OutlineTree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="OutlineTree_PreviewMouseMove"
                              DragOver="OutlineTree_DragOver" Drop="OutlineTree_Drop">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
                                <EventSetter Event="Expanded" Handler="TreeViewItem_ExpandedChanged"/>
                                <EventSetter Event="Collapsed" Handler="TreeViewItem_ExpandedChanged"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="13" MinWidth="120"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                                             KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="新建子节点" Click="CtxAddChild_Click"/>
                                <MenuItem Header="新建同级节点 (Enter)" Click="CtxAddSibling_Click"/>
                                <MenuItem Header="重命名 (F2)" Click="CtxRename_Click"/>
                                <MenuItem Header="克隆节点（含子级）" Click="CtxDuplicate_Click"/>
                                <Separator/>
                                <MenuItem Header="同级上移" Click="CtxMoveUp_Click"/>
                                <MenuItem Header="同级下移" Click="CtxMoveDown_Click"/>
                                <MenuItem Header="子项按标题排序" Click="CtxSortChildren_Click"/>
                                <Separator/>
                                <MenuItem Header="仅导出此节点为 MD..." Click="MenuExportSingleNode_Click"/>
                                <MenuItem Header="导出此分支（含子级）为 MD..." Click="MenuExportSubtree_Click"/>
                                <Separator/>
                                <MenuItem Header="删除节点 (Del)" Foreground="{DynamicResource DangerBrush}" Click="CtxDelete_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- 中央编辑与虚拟化预览区 -->
            <Grid Grid.Column="2" Background="{DynamicResource AppBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="EmptyOverlay" Grid.RowSpan="5" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="点击左侧节点开始编辑，或点击 + 新建根节点" FontSize="14" Foreground="{DynamicResource MutedFg}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 标题栏与纯粹双视图（编辑 / 预览） -->
                <Border x:Name="EditorHeaderBar" Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnViewEdit" Style="{StaticResource FlatToolBtn}" Content="编辑" Click="BtnViewEdit_Click"/>
                            <Button x:Name="BtnViewPreview" Style="{StaticResource FlatToolBtn}" Content="预览" Click="BtnViewPreview_Click"/>
                        </StackPanel>
                        <TextBox x:Name="TxtNodeTitle" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextFg}" CaretBrush="{DynamicResource CaretBrush}"
                                 FontSize="19" FontWeight="Bold" VerticalContentAlignment="Center"
                                 TextChanged="TxtNodeTitle_TextChanged"/>
                    </DockPanel>
                </Border>

                <!-- 快捷排版工具栏 -->
                <Border x:Name="FormatToolBar" Grid.Row="1" Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,3">
                    <WrapPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MiniFmtBtn}" Content="↶" ToolTip="撤销 (Ctrl+Z)" Click="FmtUndo_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="↷" ToolTip="重做 (Ctrl+Y)" Click="FmtRedo_Click"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="H" FontWeight="Bold" ToolTip="切换标题级别" Click="FmtHeading_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="B" FontWeight="Bold" ToolTip="加粗 (Ctrl+B)" Click="FmtBold_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="I" FontStyle="Italic" ToolTip="斜体 (Ctrl+I)" Click="FmtItalic_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="S" ToolTip="删除线" Click="FmtStrike_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="`c`" ToolTip="行内代码" Click="FmtInlineCode_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="代码块" Click="FmtCodeBlock_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="&gt; 引用" Click="FmtQuote_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="[ ] 待办" Click="FmtTask_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="链接" ToolTip="插入链接 (Ctrl+L)" Click="FmtLink_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="表格" Click="FmtTable_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="📎 插图/附件" ToolTip="复制文件至 files/ 并插入" Click="FmtInsertFile_Click"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="全部折叠" Click="FmtFoldAll_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="全部展开" Click="FmtUnfoldAll_Click"/>
                        <Button Style="{StaticResource MiniFmtBtn}" Content="🔍 查找替换" ToolTip="Ctrl+F / Ctrl+H" Click="FmtFind_Click"/>
                    </WrapPanel>
                </Border>

                <!-- 自绘高对比文内查找替换条（独立占行，彻底避免被 WinFormsHost 遮挡） -->
                <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed"
                        Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="查找：" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtFind" Width="170" Padding="5,3" FontSize="12.5"
                                 Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextFg}"
                                 BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource CaretBrush}"
                                 TextChanged="TxtFind_TextChanged" PreviewKeyDown="TxtFind_PreviewKeyDown"/>
                        <ToggleButton x:Name="ChkCase" Content="区分大小写" Padding="6,3" Margin="4,0,0,0" FontSize="11.5"
                                      Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextFg}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Checked="FindOption_Changed" Unchecked="FindOption_Changed"/>
                        <ToggleButton x:Name="ChkRegex" Content="正则" Padding="6,3" Margin="3,0,0,0" FontSize="11.5"
                                      Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextFg}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Checked="FindOption_Changed" Unchecked="FindOption_Changed"/>
                        <TextBlock x:Name="TxtFindCount" Text="0/0" VerticalAlignment="Center" Margin="8,0"
                                   FontSize="12" Foreground="{DynamicResource MutedFg}" MinWidth="42" TextAlignment="Center"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="↑ 上一个" Click="BtnFindPrev_Click"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="↓ 下一个" Click="BtnFindNext_Click"/>

                        <TextBlock Text="替换：" FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <TextBox x:Name="TxtReplace" Width="150" Padding="5,3" FontSize="12.5"
                                 Background="{DynamicResource SurfaceBg}" Foreground="{DynamicResource TextFg}"
                                 BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource CaretBrush}"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="替换" Margin="4,0,0,0" Click="BtnReplaceOne_Click"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="全部替换" Click="BtnReplaceAll_Click"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="×" Margin="6,0,0,0" Click="BtnCloseFind_Click"/>
                    </WrapPanel>
                </Border>

                <!-- 主体内容区：Scintilla 编辑宿主 与 虚拟化预览列表 -->
                <Grid Grid.Row="3">
                    <wfi:WindowsFormsHost x:Name="EditorHost" Visibility="Collapsed"/>

                    <ListBox x:Name="PreviewList" BorderThickness="0" Background="{DynamicResource AppBg}"
                             Padding="20,14,20,36"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             VirtualizingPanel.ScrollUnit="Item"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PreviewList_MouseDoubleClick"
                             PreviewMouseWheel="PreviewList_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:PreviewBlockPresenter Block="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="切换到编辑模式 (Ctrl+E)" Click="BtnViewEdit_Click"/>
                                <MenuItem Header="复制节点 Markdown 原文" Click="PreviewCopyMd_Click"/>
                                <Separator/>
                                <MenuItem Header="折叠预览全部标题" Click="PreviewFoldAll_Click"/>
                                <MenuItem Header="展开预览全部标题" Click="PreviewUnfoldAll_Click"/>
                                <Separator/>
                                <MenuItem Header="仅导出此节点为 MD..." Click="MenuExportSingleNode_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>

                <!-- 底部状态栏 -->
                <Border Grid.Row="4" Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCursorInfo" Text="行 1, 列 1" FontSize="11.5" Foreground="{DynamicResource MutedFg}"/>
                            <TextBlock x:Name="TxtDocStats" Text="0 字 · 1 行" FontSize="11.5" Margin="16,0,0,0" Foreground="{DynamicResource MutedFg}"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFilesDirInfo" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="附件目录: files/" FontSize="11.5" Foreground="{DynamicResource MutedFg}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>

            <!-- 右侧：当前节点正文大纲（默认隐藏，树形主从折叠，不随打字卡顿刷新） -->
            <Border x:Name="RightTocPanel" Grid.Column="4" Background="{DynamicResource SidebarBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="正文大纲" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource MutedFg}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MiniFmtBtn}" Content="↻" ToolTip="刷新正文大纲与折叠" Click="BtnRefreshToc_Click"/>
                                <Button Style="{StaticResource MiniFmtBtn}" Content="⊞" ToolTip="展开全部标题" Click="BtnExpandToc_Click"/>
                                <Button Style="{StaticResource MiniFmtBtn}" Content="⊟" ToolTip="折叠全部标题" Click="BtnCollapseToc_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TreeView x:Name="RightTocTree" Background="Transparent" BorderThickness="0" Padding="4"
                              SelectedItemChanged="RightTocTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
                                <Setter Property="Padding" Value="2,2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Text}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 内嵌设置浮层 -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Width="450" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource AppBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="LiteList 设置" FontWeight="Bold" FontSize="16" Margin="0,0,0,14"/>
                    <TextBlock Text="保存策略" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbManualSave" Content="手动安全模式（推荐，零卡顿：Ctrl+S 保存，切换/退出提示）"
                                 Foreground="{DynamicResource TextFg}" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbIdleAutoSave" Content="空闲自动保存（停止输入 3 秒后静默写入）"
                                 Foreground="{DynamicResource TextFg}" Margin="0,0,0,14"/>

                    <TextBlock Text="窗口失去焦点时（切去其他软件）" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbBlurAction" Margin="0,0,0,14" Padding="6,4">
                        <ComboBoxItem Content="不作处理（保留未保存状态）"/>
                        <ComboBoxItem Content="弹窗询问是否保存"/>
                        <ComboBoxItem Content="自动静默保存"/>
                    </ComboBox>

                    <TextBlock Text="正文字号（默认采用系统默认字体）" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="TxtSettingFontVal" Width="54" VerticalAlignment="Center" Text="15 px"/>
                        <Slider x:Name="SldFontSize" Minimum="12" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="SldFontSize_ValueChanged"/>
                    </DockPanel>

                    <CheckBox x:Name="ChkAutoVacuum" Content="退出软件存盘时自动检测碎片并压缩数据库 (VACUUM)"
                              Foreground="{DynamicResource TextFg}" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatToolBtn}" Content="取消" Width="80" Click="BtnSettingsCancel_Click"/>
                        <Button Style="{StaticResource FlatToolBtn}" Content="确定保存" Width="90" Margin="8,0,0,0"
                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                                Click="BtnSettingsOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 大图灯箱浮层 -->
        <Grid x:Name="LightboxOverlay" Grid.RowSpan="3" Background="#D8000000" Visibility="Collapsed"
              MouseLeftButtonUp="LightboxOverlay_Click">
            <Image x:Name="LightboxImg" Margin="32" Stretch="Uniform"/>
        </Grid>
    </Grid>
</Window>
